#!version:1.0.0.1
##File header "#!version:1.0.0.1" can not be edited or deleted.##

#######################################################################################
##                        PHONE SPECIFIC OVERRIDES                                   ##
#######################################################################################
{% for key, value in config.phone.items() %}
{%- if value is not none %}
{{ key }} = {{ value }}
{% endif %}
{%- endfor %}

#######################################################################################
##                        ACCOUNTS CONFIGURATION                                     ##
#######################################################################################
{% for acc in config.accounts %}
account.{{ acc.index }}.enable = 1
account.{{ acc.index }}.label = {{ acc.name }}
account.{{ acc.index }}.display_name = {{ acc.display_name or acc.username }}
account.{{ acc.index }}.auth_name = {{ acc.username }}
account.{{ acc.index }}.user_name = {{ acc.username }}
account.{{ acc.index }}.password = {{ acc.password }}
account.{{ acc.index }}.sip_server.1.address = {{ acc.sip_server }}
account.{{ acc.index }}.sip_server.1.port = {{ acc.sip_port }}
account.{{ acc.index }}.sip_server.1.transport_type = {{ 2 if acc.transport == 'tcp' else (3 if acc.transport == 'tls' else 0) }}
account.{{ acc.index }}.codec.1.enable = 1
account.{{ acc.index }}.codec.1.payload_type = PCMU
account.{{ acc.index }}.codec.1.priority = 1
account.{{ acc.index }}.codec.2.enable = 1
account.{{ acc.index }}.codec.2.payload_type = PCMA
account.{{ acc.index }}.codec.2.priority = 2
{% endfor %}

#######################################################################################
##                        DSS Keys (Line Keys)                                       ##
#######################################################################################
{% for key in config.dss_keys %}
{%- if key.type == 0 %}
linekey.{{ key.line }}.enable = 0
linekey.{{ key.line }}.type = 0
linekey.{{ key.line }}.value = ""
linekey.{{ key.line }}.extension = ""
linekey.{{ key.line }}.label = ""
linekey.{{ key.line }}.line = 0
{%- else %}
linekey.{{ key.line }}.enable = 1
linekey.{{ key.line }}.type = {{ key.type }}
linekey.{{ key.line }}.value = "{{ key.value | default('') }}"
linekey.{{ key.line }}.extension = "{{ key.extension | default('') }}"
linekey.{{ key.line }}.label = "{{ key.label | default('') }}"
{%- if key.type == 13 %}
linekey.{{ key.line }}.line = {{ key.account | default(0) }}
{%- elif key.type == 15 %}
linekey.{{ key.line }}.line = {{ key.account | default(1) }}
{%- elif key.type == 16 %}
linekey.{{ key.line }}.line = {{ key.account | default(1) }}
{% endif %}
{% endif %}
{% endfor %}
