# Copy to .env and fill in real values:
#   cp .env.example .env

DEBUG=false

# Public URL phones use (no trailing slash)
PUBLIC_BASE_URL=https://ncdc.example.com

# Random string, at least 16 chars (python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=replace-with-a-long-random-string

# Admin UI (HTTP Basic)
NCDC_ADMIN_USER=admin
NCDC_ADMIN_PASS=replace-with-strong-admin-password

# Phone provisioning (Yealink static.auto_provision.username / password)
PROVISION_AUTH_ENABLED=true
PROVISION_USER=provision
PROVISION_PASS=replace-with-strong-provision-password

# Shared secret phones send as ?token= on Action URL
ACTION_URI_TOKEN=replace-with-random-token

# Create unknown MACs on first Action URL / cfg request
AUTO_ENROLL=true

# 1 = provisioned values overwrite local phone settings
BOOT_OVERWRITE_MODE=1

AUDIT_RETENTION_DAYS=90
OFFLINE_TIMEOUT_MINUTES=5

# Yealink web UI certificates are self-signed
AUTOP_VERIFY_SSL=false
AUTOP_TIMEOUT=5

DATABASE_URL=sqlite:///./data/ncdc.db
